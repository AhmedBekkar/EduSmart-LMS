@model EduSmart.Models.Kayitlar
@{
    ViewBag.Title = "Yeni Kayıt Ekle";
}

<style>
    .form-container {
        max-width: 650px;
        margin: 2rem auto;
        animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes slideUp {
        0% { transform: translateY(30px); opacity: 0; }
        100% { transform: translateY(0); opacity: 1; }
    }

    .glass-form-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: 24px;
        padding: 3rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05), inset 0 0 0 1px rgba(255,255,255,0.6);
        position: relative;
        overflow: hidden;
    }
    
    .glass-form-card::before {
        content: '';
        position: absolute;
        top: -50px; right: -50px;
        width: 150px; height: 150px;
        background: radial-gradient(circle, rgba(217, 70, 239, 0.1) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%;
    }

    .form-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .form-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #fdf4ff 0%, #fae8ff 100%);
        color: #d946ef;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 1.5rem auto;
        box-shadow: 0 10px 20px rgba(217, 70, 239, 0.15);
    }

    .form-title {
        font-weight: 800;
        font-size: 1.8rem;
        color: #0f172a;
        letter-spacing: -0.5px;
    }

    /* Modern Inputs */
    .form-label {
        font-weight: 600;
        color: #475569;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .form-control {
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.8rem 1.2rem;
        font-size: 1rem;
        color: #1e293b;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        background: white;
        border-color: #d946ef;
        box-shadow: 0 0 0 4px rgba(217, 70, 239, 0.1);
        outline: none;
    }

    .form-group-modern {
        margin-bottom: 1.8rem;
    }

    /* Buttons */
    .btn-submit {
        background: linear-gradient(135deg, #d946ef, #a855f7);
        color: white;
        font-weight: 700;
        border: none;
        padding: 0.8rem 2rem;
        border-radius: 12px;
        width: 100%;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(217, 70, 239, 0.2);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(217, 70, 239, 0.3);
    }

    .btn-cancel {
        color: #64748b;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        margin-top: 1rem;
        transition: color 0.2s;
    }
    
    .btn-cancel:hover {
        color: #0f172a;
    }
</style>

<div class="form-container">
    <div class="glass-form-card">
        <div class="form-header">
            <div class="form-icon">
                <i class="fa-solid fa-user-plus"></i>
            </div>
            <h2 class="form-title">Yeni Kayıt Ekle</h2>
            <p class="text-secondary">Bir öğrenciyi yeni bir derse kaydedin.</p>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3 fw-bold" })

            <div class="form-group-modern">
                @Html.Label("OgrenciID", "Öğrenci Seçin", new { @class = "form-label" })
                @Html.DropDownList("OgrenciID", null, "-- Öğrenci Seçin --", new { @class = "form-control", id = "OgrenciID" })
                @Html.ValidationMessageFor(m => m.OgrenciID, "", new { @class = "text-danger small fw-semibold mt-1 d-block" })
            </div>
            
            <div class="form-group-modern">
                @Html.Label("DersID", "Ders Seçin", new { @class = "form-label" })
                @Html.DropDownList("DersID", null, "-- Ders Seçin --", new { @class = "form-control", id = "DersID" })
                @Html.ValidationMessageFor(m => m.DersID, "", new { @class = "text-danger small fw-semibold mt-1 d-block" })
            </div>

            <div class="text-center mt-2">
                <button type="submit" class="btn btn-submit">
                    <i class="fa-solid fa-plus me-2"></i> Kaydı Oluştur
                </button>
                <br />
                <a href="@Url.Action("Index")" class="btn-cancel">
                    <i class="fa-solid fa-arrow-left me-1"></i> Listeye Dön
                </a>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function() {
            $('#OgrenciID').change(function() {
                var ogrenciId = $(this).val();
                var dersDropdown = $('#DersID');
                
                if (ogrenciId) {
                    $.ajax({
                        url: '@Url.Action("GetAvailableSubjects", "Kayitlar")',
                        type: 'GET',
                        data: { ogrenciId: ogrenciId },
                        success: function(data) {
                            dersDropdown.empty();
                            dersDropdown.append($('<option>-- Ders seçin --</option>'));
                            $.each(data, function(index, item) {
                                dersDropdown.append($('<option></option>').val(item.DersID).text(item.DersAdi));
                            });
                        },
                        error: function() {
                            alert('Dersler yüklenirken bir hata oluştu.');
                        }
                    });
                } else {
                    dersDropdown.empty();
                    dersDropdown.append($('<option>-- Ders seçin --</option>'));
                }
            });
        });
    </script>
}
