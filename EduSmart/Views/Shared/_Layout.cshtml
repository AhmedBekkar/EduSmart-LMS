                    <span id="chatConnectionStatus" class="status-dot disconnected" title="Bağlantı Bekleniyor..."></span>
                    <button id="toggleChatBtn" class="btn btn-sm text-white border-0"><i class="fa-solid fa-chevron-up"></i></button>
                </div>
            </div>
            <div class="chat-body" id="chatBody">
                <div class="chat-messages" id="chatMessages">
                    <div class="chat-message system-msg text-center my-3">
                        <small class="text-muted"><i class="fa-solid fa-shield-check me-1"></i> Global sohbet odasına hoş geldiniz.</small>
                    </div>
