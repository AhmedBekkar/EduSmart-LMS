    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    
    <!-- SignalR Required Scripts -->
    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <script src="~/signalr/hubs"></script>

    <!-- DataTables & Plugins -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const toggleBtn = document.getElementById('sidebarToggle');
            const body = document.body;

            // Load saved state from localStorage
            const sidebarState = localStorage.getItem('sidebarState');
            
            // Default on mobile is collapsed, on desktop is expanded
            if (window.innerWidth <= 991) {
                body.classList.add('sidebar-collapsed');
            } else {
                if (sidebarState === 'collapsed') {
                    body.classList.add('sidebar-collapsed');
                } else {
                    body.classList.remove('sidebar-collapsed');
                }
            }

            // Toggle functionality
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function() {
                    body.classList.toggle('sidebar-collapsed');
                    
                    // Save state
                    if (window.innerWidth > 991) {
                        if (body.classList.contains('sidebar-collapsed')) {
                            localStorage.setItem('sidebarState', 'collapsed');
                        } else {
                            localStorage.setItem('sidebarState', 'expanded');
                        }
                    }
                });
            }

            // Auto-collapse on small screens if resized
            window.addEventListener('resize', function() {
                if (window.innerWidth <= 991) {
                    body.classList.add('sidebar-collapsed');
                } else {
                    const state = localStorage.getItem('sidebarState');
                    if (state !== 'collapsed') {
                        body.classList.remove('sidebar-collapsed');
                    }
                }
            });

            // --- GLOBAL SEARCH FUNCTIONALITY ---
            const searchInput = document.querySelector('.search-input');
            
            // Ctrl+K or Cmd+K to focus search
            document.addEventListener('keydown', function(e) {
                if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                    e.preventDefault();
                    if (searchInput) {
                        searchInput.focus();
                    }
                }
            });

            // Live filtering of tables and cards
            if (searchInput) {
                searchInput.addEventListener('input', function(e) {
                    const searchTerm = e.target.value.toLowerCase().trim();
                    const targetItems = document.querySelectorAll('.smart-table tbody tr, .table-modern tbody tr, .course-card');
                    
                    targetItems.forEach(item => {
                        const itemText = item.textContent.toLowerCase();
                        if (itemText.includes(searchTerm)) {
                            item.style.display = '';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            }
        });

        // --- SIGNALR CHAT LOGIC ---
        $(function () {
            // Widget Toggle Logic
            $('#chatHeader').click(function(e) {
                if($(e.target).closest('button').length === 0) {
                    $('#chatWidget').toggleClass('collapsed');
                    $('#toggleChatBtn i').toggleClass('fa-chevron-up fa-chevron-down');
                }
            });
            
            $('#toggleChatBtn').click(function() {
                $('#chatWidget').toggleClass('collapsed');
                $('#toggleChatBtn i').toggleClass('fa-chevron-up fa-chevron-down');
            });

            // SignalR Setup
            var chat = $.connection.chatHub;
            
            if(chat) {
                // Client method to receive messages
                chat.client.broadcastMessage = function (name, role, avatar, message, time) {
                    var roleBadge = role === 'OGRETMEN' ? '<span class="badge bg-primary ms-1" style="font-size:0.6rem;">Öğrt</span>' : 
                                  (role === 'YONETICI' ? '<span class="badge bg-danger ms-1" style="font-size:0.6rem;">Yön</span>' : '');
                                  
                    var msgHtml = `
                        <div class="chat-message incoming">
                            <div class="chat-avatar">${avatar}</div>
                            <div class="chat-bubble">
                                <div class="chat-author">${name} ${roleBadge}</div>
                                <div class="chat-text">${message}</div>
                                <div class="chat-time">${time}</div>
                            </div>
                        </div>
                    `;
                    $('#chatMessages').append(msgHtml);
                    
                    // Auto scroll to bottom
                    var chatDiv = document.getElementById("chatMessages");
                    chatDiv.scrollTop = chatDiv.scrollHeight;
                    
                    // Play subtle notification sound if message is incoming
                    // Creating an audio element dynamically to ensure it works across browsers
                    try {
                        var audio = new Audio('https://actions.google.com/sounds/v1/alarms/beep_short.ogg');
                        audio.volume = 0.2;
                        audio.play();
                    } catch(e) { }

                    // If widget is collapsed, pop it up a bit or flash it
                    if($('#chatWidget').hasClass('collapsed')) {
                        $('#chatHeader').addClass('flash');
                        setTimeout(() => $('#chatHeader').removeClass('flash'), 1000);
                    }
                };

                chat.client.userConnected = function(name) {
                    $('#chatMessages').append(`<div class="chat-message system-msg text-center my-2"><small class="text-muted">${name} katıldı.</small></div>`);
                };
                
                chat.client.userDisconnected = function(name) {
                    $('#chatMessages').append(`<div class="chat-message system-msg text-center my-2"><small class="text-muted">${name} ayrıldı.</small></div>`);
                };

                // Notification Client Method
                chat.client.receiveNotification = function(notification) {
                    var currentUserRole = '@Html.Raw(Session["UserRole"] ?? "")';
                    var currentUserIdStr = '@Html.Raw(Session["UserId"] ?? "")';
                    
                    var isTarget = false;
                    if(notification.UserId && notification.UserId.toString() === currentUserIdStr) {
                        isTarget = true;
                    } else if (!notification.UserId && (notification.Role === 'All' || notification.Role === currentUserRole)) {
                        isTarget = true;
                    }
                    
                    if(isTarget) {
                        renderSingleNotification(notification, true);
                        updateBadgeCount(1);
                        // Play notification sound
                        try {
                            var audio = new Audio('https://actions.google.com/sounds/v1/alarms/beep_short.ogg');
                            audio.volume = 0.2;
                            audio.play();
                        } catch(e) { }
                    }
                };

                // Start connection
                $.connection.hub.start().done(function () {
                    $('#chatConnectionStatus').removeClass('disconnected').addClass('connected').attr('title', 'Bağlandı');
                    
                    var currentUser = '@Html.Raw(Session["UserName"] ?? "Misafir")';
                    var currentRole = '@Html.Raw(Session["UserRole"] ?? "")';
                    
                    chat.server.connectUser(currentUser);
                    
                    // Send button click
                    $('#chatSendBtn').click(function () {
                        sendMessage();
                    });
                    
                    // Enter key to send
                    $('#chatInput').keypress(function (e) {
                        if (e.which == 13) {
                            sendMessage();
                        }
                    });
                    
                    function sendMessage() {
                        var msg = $('#chatInput').val();
                        if(msg.trim().length > 0) {
                            chat.server.sendMessage(currentUser, currentRole, msg);
                            $('#chatInput').val('').focus();
                        }
                    }
                }).fail(function(e) {
                    console.error("SignalR connection error: " + e);
                    $('#chatConnectionStatus').removeClass('connected').addClass('disconnected').attr('title', 'Bağlantı Hatası');
                });
            }
        });
        // --- DATATABLES INITIALIZATION ---
        $(document).ready(function () {
            $('.smart-table, .table-modern').each(function() {
                // Prevent double initialization
                if (!$.fn.DataTable.isDataTable(this)) {
                    $(this).DataTable({
                        dom: '<"d-flex justify-content-between align-items-center mb-3"Bf>rt<"d-flex justify-content-between align-items-center mt-3"ip>',
                        buttons: [
                            {
                                extend: 'copyHtml5',
                                text: '<i class="fa-solid fa-copy me-1"></i> Kopyala',
                                className: 'btn'
                            },
                            {
                                extend: 'excelHtml5',
                                text: '<i class="fa-solid fa-file-excel me-1"></i> Excel',
                                className: 'btn buttons-excel'
                            },
                            {
                                extend: 'pdfHtml5',
                                text: '<i class="fa-solid fa-file-pdf me-1"></i> PDF',
                                className: 'btn buttons-pdf',
                                orientation: 'landscape',
                                pageSize: 'A4'
                            },
                            {
                                extend: 'print',
                                text: '<i class="fa-solid fa-print me-1"></i> Yazdır',
                                className: 'btn buttons-print'
                            }
                        ],
                        language: {
                            "emptyTable": "Tabloda herhangi bir veri mevcut değil",
                            "info": "_TOTAL_ kayıttan _START_ - _END_ arasındaki kayıtlar gösteriliyor",
                            "infoEmpty": "Kayıt yok",
                            "infoFiltered": "(_MAX_ kayıt içerisinden bulunan)",
                            "infoThousands": ".",
                            "lengthMenu": "Sayfada _MENU_ kayıt göster",
                            "loadingRecords": "Yükleniyor...",
                            "processing": "İşleniyor...",
                            "search": "Ara:",
                            "zeroRecords": "Eşleşen kayıt bulunamadı",
                            "paginate": {
                                "first": "İlk",
                                "last": "Son",
                                "next": "Sonraki",
                                "previous": "Önceki"
                            },
                            "aria": {
                                "sortAscending": ": artan sütun sıralamasını aktifleştir",
                                "sortDescending": ": azalan sütun sıralamasını aktifleştir"
                            }
                        },
                        pageLength: 10,
                        responsive: true,
                        order: [] // Don't sort automatically on load to preserve original sorting
                    });
                }
            });
        });

        // --- NOTIFICATIONS UI LOGIC ---
        $(document).ready(function() {
            var notifBadge = $('#notifBadge');
            var notifMenu = $('#notifMenu');
            var notifToggle = $('#notifToggle');
            var notifBody = $('#notifBody');
            var unreadCount = 0;

            // Toggle dropdown
            notifToggle.click(function(e) {
                e.stopPropagation();
                notifMenu.toggleClass('show');
            });

            // Close when clicking outside
            $(document).click(function(e) {
                if (!$(e.target).closest('.notification-dropdown').length) {
                    notifMenu.removeClass('show');
                }
            });

            // Fetch initial notifications
            $.get('@Url.Action("GetMyNotifications", "Notifications")', function(res) {
                if(res.success && res.data) {
                    notifBody.empty();
                    if(res.data.length === 0) {
                        notifBody.append('<div class="notif-empty">Hiç bildiriminiz yok.</div>');
                    } else {
                        res.data.forEach(function(n) {
                            renderSingleNotification(n, false);
                            if(!n.IsRead) unreadCount++;
                        });
                        updateBadgeCount(unreadCount);
                    }
                }
            });

            window.renderSingleNotification = function(n, prepend) {
                if(notifBody.find('.notif-empty').length > 0) notifBody.empty();
                
                var date = new Date(parseInt(n.CreatedAt.substr(6)));
                var timeStr = date.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }) + ' ' + date.toLocaleDateString('tr-TR');
                
                var iconHtml = n.Icon ? `<i class="${n.Icon}"></i>` : `<i class="fa-solid fa-bell text-primary"></i>`;
                var bgClass = n.Icon && n.Icon.includes('text-danger') ? 'bg-danger-subtle text-danger' : 
                              (n.Icon && n.Icon.includes('text-success') ? 'bg-success-subtle text-success' : 'bg-primary-subtle text-primary');

                var itemHtml = `
                    <div class="notif-item ${n.IsRead ? '' : 'unread'}" data-id="${n.Id}">
                        <div class="notif-icon ${bgClass}">
                            ${iconHtml}
                        </div>
                        <div class="notif-content">
                            <div class="notif-title">${n.Title}</div>
                            <div class="notif-msg">${n.Message}</div>
                            <div class="notif-time">${timeStr}</div>
                        </div>
                    </div>
                `;

                if(prepend) {
                    notifBody.prepend(itemHtml);
                } else {
                    notifBody.append(itemHtml);
                }
            };

            window.updateBadgeCount = function(count) {
                var current = parseInt(notifBadge.text()) || 0;
                var total = count === 1 ? current + 1 : count; // if count=1 assume incremental, else absolute
                notifBadge.text(total);
                if(total > 0) {
                    notifBadge.addClass('active');
                } else {
                    notifBadge.removeClass('active');
                }
            };

            // Mark single as read
            notifBody.on('click', '.notif-item.unread', function() {
                var item = $(this);
                var id = item.data('id');
                $.post('@Url.Action("MarkAsRead", "Notifications")', { id: id }, function(res) {
                    if(res.success) {
                        item.removeClass('unread');
                        var current = parseInt(notifBadge.text()) - 1;
                        notifBadge.text(current);
                        if(current <= 0) notifBadge.removeClass('active');
                    }
                });
            });

            // Mark all read
            $('#notifMarkAllRead').click(function() {
                $.post('@Url.Action("MarkAllAsRead", "Notifications")', function(res) {
                    if(res.success) {
                        $('.notif-item.unread').removeClass('unread');
                        notifBadge.text('0').removeClass('active');
                    }
                });
            });
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
