@model EduSmart.Models.Teslimler
@{
    ViewBag.Title = "Not Ver";
    var existingGrade = ViewBag.ExistingGrade as EduSmart.Models.Notlar;
    var hasExistingGrade = existingGrade != null && existingGrade.FinalPuani.HasValue;
    var gradeValue = hasExistingGrade ? existingGrade.FinalPuani.Value.ToString("F1") : "";
    var buttonText = hasExistingGrade ? "Notu Güncelle" : "Notu Kaydet";
}

<style>
    .eval-container {
        max-width: 900px;
        margin: 2rem auto;
        animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes slideUp {
        0% { transform: translateY(30px); opacity: 0; }
        100% { transform: translateY(0); opacity: 1; }
    }

    .eval-card {
        background: white;
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .eval-header {
        background: linear-gradient(135deg, #1e293b, #0f172a);
        padding: 2.5rem;
        color: white;
        position: relative;
    }
    
    .eval-header::after {
        content: '\f19d';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        position: absolute;
        right: 30px;
        top: 20px;
        font-size: 8rem;
        color: rgba(255,255,255,0.05);
        transform: rotate(15deg);
    }

    .student-info {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .student-avatar-large {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #3b82f6, #06b6d4);
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        color: white;
        font-weight: 800;
        box-shadow: 0 10px 20px rgba(59, 130, 246, 0.3);
        border: 3px solid rgba(255,255,255,0.2);
    }

    .student-details h2 {
        margin: 0;
        font-weight: 800;
        font-size: 2rem;
    }

    .eval-body {
        padding: 2.5rem;
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 2.5rem;
    }
    
    @@media (max-width: 992px) {
        .eval-body { grid-template-columns: 1fr; }
    }

    /* Submission Content Area */
    .submission-viewer {
        background: #f8fafc;
        border-radius: 20px;
        padding: 2rem;
        border: 2px dashed #cbd5e1;
    }

    .content-box {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        color: #334155;
        line-height: 1.7;
        margin-bottom: 1.5rem;
        font-size: 1.05rem;
    }

    .file-download-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        background: white;
        border: 2px solid #3b82f6;
        color: #3b82f6;
        padding: 1rem 1.5rem;
        border-radius: 16px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s ease;
        width: 100%;
        justify-content: center;
    }

    .file-download-btn:hover {
        background: #3b82f6;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(59, 130, 246, 0.2);
    }

    /* Grading Area */
    .grading-panel {
        background: #fff;
        border-radius: 20px;
        padding: 2rem;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 25px rgba(0,0,0,0.02);
        height: fit-content;
    }

    .grade-input-wrapper {
        position: relative;
        margin-bottom: 2rem;
    }

    .grade-input {
        width: 100%;
        font-size: 3.5rem;
        font-weight: 900;
        text-align: center;
        color: #0f172a;
        background: #f1f5f9;
        border: 3px solid transparent;
        border-radius: 20px;
        padding: 1rem;
        transition: all 0.3s;
    }

    .grade-input:focus {
        background: white;
        border-color: #10b981;
        outline: none;
        box-shadow: 0 0 0 5px rgba(16, 185, 129, 0.1);
        color: #10b981;
    }

    .grade-input-wrapper::after {
        content: '/ 100';
        position: absolute;
        bottom: 20px;
        right: 20px;
        font-size: 1.2rem;
        color: #94a3b8;
        font-weight: 700;
    }

    .btn-submit-grade {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        font-weight: 800;
        font-size: 1.1rem;
        border: none;
        padding: 1rem;
        border-radius: 16px;
        width: 100%;
        transition: all 0.3s;
        box-shadow: 0 10px 20px rgba(16, 185, 129, 0.2);
    }

    .btn-submit-grade:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(16, 185, 129, 0.3);
    }
    
    .existing-grade-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #ecfdf5;
        color: #059669;
        padding: 0.5rem 1rem;
        border-radius: 30px;
        font-weight: 700;
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
        border: 1px solid #a7f3d0;
    }
</style>

@if (Model == null)
{
    <div class="eval-container">
        <div class="alert alert-danger" style="border-radius: 20px; padding: 2rem;">
            <h4 class="alert-heading fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i> Teslim Bulunamadı!</h4>
            <p>Aradığınız öğrenci teslimi sistemde mevcut değil veya silinmiş olabilir.</p>
            <hr>
            <a href="@Url.Action("Index")" class="btn btn-outline-danger fw-bold rounded-pill px-4">Listeye Dön</a>
        </div>
    </div>
}
else
{
    var ogrenciAdi = Model.Kullanicilar?.AdSoyad ?? "Bilinmiyor";
    var basHarf = string.IsNullOrWhiteSpace(ogrenciAdi) ? "?" : ogrenciAdi.Substring(0, 1).ToUpper();

    <div class="eval-container">
        <div class="eval-card">
            
            <div class="eval-header">
                <div class="student-info">
                    <div class="student-avatar-large">
                        @basHarf
                    </div>
                    <div class="student-details">
                        <div class="text-uppercase small fw-bold mb-1" style="color: #94a3b8; letter-spacing: 1px;">Öğrenci Teslimi</div>
                        <h2>@ogrenciAdi</h2>
                        <div class="mt-2" style="color: #cbd5e1; font-size: 1.05rem;">
                            <i class="fa-solid fa-book-open me-2"></i>@(Model.Odevler?.Baslik ?? "İsimsiz Ödev")
                        </div>
                    </div>
                </div>
            </div>

            <div class="eval-body">
                
                <!-- Left Column: Submission Content -->
                <div>
                    <h5 class="fw-bold mb-3" style="color: #475569;">
                        <i class="fa-solid fa-align-left me-2 text-primary"></i> Teslim Edilen İçerik
                    </h5>
                    
                    <div class="submission-viewer">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-primary rounded-pill px-3 py-2">
                                <i class="fa-regular fa-clock me-1"></i> @(Model.TeslimTarihi.HasValue ? Model.TeslimTarihi.Value.ToString("dd MMMM yyyy HH:mm") : "-")
                            </span>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.IcerikMetni))
                        {
                            <div class="content-box">
                                @Model.IcerikMetni
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-secondary mb-3" style="border-radius: 12px; border-style: dashed;">
                                <i class="fa-solid fa-comment-slash me-2"></i> Öğrenci herhangi bir metin açıklaması eklememiş.
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.DosyaYolu))
                        {
                            <a href="@Model.DosyaYolu" target="_blank" class="file-download-btn">
                                <i class="fa-solid fa-file-arrow-down fs-4"></i>
                                <span>Ekli Dosyayı İncele / İndir</span>
                            </a>
                        }
                        else
                        {
                             <div class="alert alert-warning mb-0" style="border-radius: 12px; border-style: dashed;">
                                <i class="fa-solid fa-file-circle-xmark me-2"></i> Ekli dosya bulunmuyor.
                            </div>
                        }
                    </div>
                </div>

                <!-- Right Column: Grading Panel -->
                <div>
                    <div class="grading-panel">
                        <h5 class="fw-bold mb-4 text-center" style="color: #0f172a;">
                            <i class="fa-solid fa-ranking-star me-2" style="color: #f59e0b;"></i> Değerlendirme
                        </h5>

                        @if (hasExistingGrade)
                        {
                            <div class="text-center">
                                <div class="existing-grade-badge">
                                    <i class="fa-solid fa-check-circle"></i> 
                                    Önceden Notlandırıldı
                                </div>
                                @if (existingGrade.PuanlamaTarihi.HasValue)
                                {
                                    <div class="small text-muted mb-3">
                                        Son işlem: @existingGrade.PuanlamaTarihi.Value.ToString("dd MMM yyyy, HH:mm")
                                    </div>
                                }
                            </div>
                        }

                        <form action="@Url.Action("Grade", "Teslimler")" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="teslimId" value="@Model.TeslimID" />

                            <div class="grade-input-wrapper">
                                <input type="number" 
                                       name="finalPuani" 
                                       id="finalPuani" 
                                       class="grade-input" 
                                       min="0" 
                                       max="100" 
                                       step="0.1" 
                                       value="@gradeValue" 
                                       placeholder="00"
                                       required />
                            </div>

                            <button type="submit" class="btn-submit-grade mb-3">
                                <i class="fa-solid fa-floppy-disk me-2"></i> @buttonText
                            </button>
                            
                            <a href="@Url.Action("Index")" class="btn btn-light w-100 fw-bold" style="border-radius: 16px; padding: 0.8rem; color: #64748b;">
                                İptal Et ve Geri Dön
                            </a>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
}
