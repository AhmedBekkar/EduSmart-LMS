@model EduSmart.Models.Teslimler
@{
    ViewBag.Title = "Teslim Sil";
}

<style>
    .form-container {
        max-width: 650px;
        margin: 2rem auto;
        animation: shakeIn 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
    }

    @@keyframes shakeIn {
        10%, 90% { transform: translate3d(-1px, 0, 0); opacity: 1; }
        20%, 80% { transform: translate3d(2px, 0, 0); }
        30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
        40%, 60% { transform: translate3d(4px, 0, 0); }
        0% { transform: translate3d(0, 50px, 0); opacity: 0; }
    }

    .glass-form-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(239, 68, 68, 0.3);
        border-radius: 24px;
        padding: 3rem;
        box-shadow: 0 20px 40px rgba(239, 68, 68, 0.1), inset 0 0 0 1px rgba(255,255,255,0.8);
        position: relative;
        overflow: hidden;
    }
    
    .glass-form-card::before {
        content: '';
        position: absolute;
        top: -50px; right: -50px;
        width: 150px; height: 150px;
        background: radial-gradient(circle, rgba(239, 68, 68, 0.15) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%;
    }

    .form-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .form-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        color: #ef4444;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        margin: 0 auto 1.5rem auto;
        box-shadow: 0 10px 20px rgba(239, 68, 68, 0.15);
        animation: pulseRed 2s infinite;
    }

    @@keyframes pulseRed {
        0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
        70% { box-shadow: 0 0 0 20px rgba(239, 68, 68, 0); }
        100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }

    .form-title {
        font-weight: 800;
        font-size: 1.8rem;
        color: #0f172a;
        letter-spacing: -0.5px;
        margin-bottom: 0.5rem;
    }

    .warning-text {
        font-size: 1.1rem;
        color: #64748b;
        margin-bottom: 2rem;
    }

    /* Info Box */
    .info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .info-row {
        display: flex;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px dashed #cbd5e1;
    }

    .info-row:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: none;
    }

    .info-label {
        font-weight: 700;
        color: #475569;
        width: 120px;
        flex-shrink: 0;
    }

    .info-value {
        color: #0f172a;
        font-weight: 600;
    }

    /* Buttons */
    .btn-danger-glow {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
        font-weight: 700;
        border: none;
        padding: 0.8rem 2rem;
        border-radius: 12px;
        width: 100%;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(239, 68, 68, 0.2);
    }

    .btn-danger-glow:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(239, 68, 68, 0.35);
    }

    .btn-cancel {
        color: #64748b;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        margin-top: 1rem;
        transition: color 0.2s;
    }
    
    .btn-cancel:hover {
        color: #0f172a;
    }
</style>

<div class="form-container">
    <div class="glass-form-card">
        <div class="form-header">
            <div class="form-icon">
                <i class="fa-solid fa-file-excel"></i>
            </div>
            <h2 class="form-title">Öğrenci Teslimini Silmek Üzeresiniz</h2>
            <p class="warning-text">Bu işlemi geri alamazsınız. Gerçekten bu teslimi silmek istiyor musunuz?</p>
        </div>

        <div class="info-box">
            <div class="info-row">
                <div class="info-label">Öğrenci:</div>
                <div class="info-value">
                    <span class="fw-bold text-dark fs-5">
                        <i class="fa-solid fa-user-graduate me-1 text-primary"></i>
                        @(Model.Kullanicilar != null ? Model.Kullanicilar.AdSoyad : "-")
                    </span>
                </div>
            </div>
            <div class="info-row">
                <div class="info-label">Ödev:</div>
                <div class="info-value">
                    <span class="fw-semibold">
                        @(Model.Odevler != null ? Model.Odevler.Baslik : "-")
                    </span>
                </div>
            </div>
            <div class="info-row">
                <div class="info-label">Durum:</div>
                <div class="info-value">
                    @if (Model.Durum == "Tamamlandı")
                    {
                        <span class="badge bg-success border px-2 py-1"><i class="fa-solid fa-check"></i> @Model.Durum</span>
                    }
                    else
                    {
                        <span class="badge bg-warning border px-2 py-1"><i class="fa-solid fa-clock"></i> @Model.Durum</span>
                    }
                </div>
            </div>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.TeslimID)

            <div class="text-center">
                <button type="submit" class="btn btn-danger-glow">
                    <i class="fa-solid fa-trash-can me-2"></i> Evet, Kalıcı Olarak Sil
                </button>
                <br />
                <a href="@Url.Action("Index")" class="btn-cancel">
                    <i class="fa-solid fa-arrow-left me-1"></i> İptal Et ve Listeye Dön
                </a>
            </div>
        }
    </div>
</div>
