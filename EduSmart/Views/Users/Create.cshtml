@model EduSmart.Models.UserInputViewModel
@{
    ViewBag.Title = "Yeni Kullanıcı Ekle";
}

<style>
    .create-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        border: none;
        overflow: hidden;
    }
    .create-header {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        padding: 2rem;
        text-align: center;
    }
    .create-header h4 {
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    .create-body {
        padding: 3rem 2.5rem;
    }
    .btn-submit {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 1rem 2rem;
        font-weight: 600;
        transition: all 0.3s;
        box-shadow: 0 8px 15px rgba(16, 185, 129, 0.3);
    }
    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 20px rgba(16, 185, 129, 0.4);
        color: white;
    }
    .btn-cancel {
        border-radius: 12px;
        padding: 1rem 2rem;
        font-weight: 600;
        color: #64748b;
        background: #f1f5f9;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-block;
    }
    .btn-cancel:hover {
        background: #e2e8f0;
        color: #334155;
    }
</style>

<div class="row justify-content-center mt-3">
    <div class="col-lg-8 col-md-10">
        <div class="card create-card gsap-form">
            <div class="create-header">
                <i class="fa-solid fa-user-plus" style="font-size: 3rem; margin-bottom: 1rem;"></i>
                <h4>Yeni Kullanıcı Ekle</h4>
                <p class="mb-0 text-white-50">Sisteme yeni bir öğrenci, öğretmen veya yönetici kaydedin.</p>
            </div>
            
            <div class="create-body">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3" })
                    
                    @Html.Partial("_UserForm", Model)
                    
                    <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
                        <a href="@Url.Action("Index")" class="btn-cancel">
                            <i class="fa-solid fa-arrow-left me-2"></i>İptal Et ve Geri Dön
                        </a>
                        <button type="submit" class="btn-submit">
                            <i class="fa-solid fa-check me-2"></i>Kullanıcıyı Kaydet
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            gsap.from(".gsap-form", { duration: 0.8, y: 30, opacity: 0, ease: "power3.out" });
        });
    </script>
}
