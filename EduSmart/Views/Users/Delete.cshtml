@model EduSmart.Models.Kullanicilar
@{
    ViewBag.Title = "Kullanıcıyı Sil";
}

<style>
    .delete-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(239, 68, 68, 0.15);
        border: 1px solid rgba(239, 68, 68, 0.2);
        overflow: hidden;
    }
    
    .delete-header {
        background: #fef2f2;
        color: #ef4444;
        padding: 3rem 2rem 2rem;
        text-align: center;
        border-bottom: 1px solid #fee2e2;
    }
    
    .delete-icon-wrapper {
        width: 80px;
        height: 80px;
        background: #ef4444;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        margin: 0 auto 1.5rem;
        box-shadow: 0 10px 20px rgba(239, 68, 68, 0.3);
    }
    
    .delete-header h4 {
        font-weight: 800;
        margin-bottom: 0.5rem;
    }
    
    .delete-body {
        padding: 3rem 2.5rem;
    }
    
    .user-info-box {
        background: #f8fafc;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border: 1px solid #e2e8f0;
    }
    
    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 0.75rem 0;
        border-bottom: 1px dashed #cbd5e1;
    }
    
    .info-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }
    
    .info-label {
        color: #64748b;
        font-weight: 600;
    }
    
    .info-value {
        color: #0f172a;
        font-weight: 700;
    }
    
    .btn-danger-confirm {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 1rem 2rem;
        font-weight: 700;
        transition: all 0.3s;
        box-shadow: 0 8px 15px rgba(239, 68, 68, 0.3);
        width: 100%;
    }
    
    .btn-danger-confirm:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 20px rgba(239, 68, 68, 0.4);
        color: white;
    }
    
    .btn-cancel {
        border-radius: 12px;
        padding: 1rem 2rem;
        font-weight: 600;
        color: #64748b;
        background: #f1f5f9;
        transition: all 0.3s;
        text-decoration: none;
        display: block;
        text-align: center;
        width: 100%;
        margin-top: 1rem;
    }
    
    .btn-cancel:hover {
        background: #e2e8f0;
        color: #334155;
    }
</style>

<div class="row justify-content-center mt-4">
    <div class="col-lg-5 col-md-7">
        <div class="card delete-card gsap-form">
            <div class="delete-header">
                <div class="delete-icon-wrapper">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h4>Emin Misiniz?</h4>
                <p class="mb-0 fw-medium">Bu işlem geri alınamaz ve kullanıcının tüm verileri kalıcı olarak silinecektir.</p>
            </div>
            
            <div class="delete-body">
                <div class="user-info-box">
                    <div class="info-row">
                        <span class="info-label"><i class="fa-solid fa-user me-2"></i>Ad Soyad</span>
                        <span class="info-value">@Model.AdSoyad</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="fa-solid fa-envelope me-2"></i>E-posta</span>
                        <span class="info-value">@Model.Eposta</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label"><i class="fa-solid fa-users-gear me-2"></i>Rol</span>
                        <span class="info-value">@Model.Rol</span>
                    </div>
                </div>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.KullaniciID)
                    
                    <button type="submit" class="btn-danger-confirm">
                        <i class="fa-solid fa-trash-can me-2"></i>Evet, Kullanıcıyı Sil
                    </button>
                    <a class="btn-cancel" href="@Url.Action("Index")">
                        Hayır, Vazgeç
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            gsap.from(".gsap-form", { duration: 0.6, scale: 0.9, opacity: 0, ease: "back.out(1.5)" });
        });
    </script>
}
