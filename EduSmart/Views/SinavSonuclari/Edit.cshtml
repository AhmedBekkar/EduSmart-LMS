@model EduSmart.Models.SinavSonuclari
@{
    ViewBag.Title = "Sonuç Düzenle";
}

<style>
    .form-container {
        max-width: 750px;
        margin: 2rem auto;
        animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes slideUp {
        0% { transform: translateY(30px); opacity: 0; }
        100% { transform: translateY(0); opacity: 1; }
    }

    .glass-form-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: 24px;
        padding: 3rem;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05), inset 0 0 0 1px rgba(255,255,255,0.6);
        position: relative;
        overflow: hidden;
    }
    
    .glass-form-card::before {
        content: '';
        position: absolute;
        top: -50px; right: -50px;
        width: 150px; height: 150px;
        background: radial-gradient(circle, rgba(13, 148, 136, 0.1) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%;
    }

    .form-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .form-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #ccfbf1 0%, #99f6e4 100%);
        color: #0d9488;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 1.5rem auto;
        box-shadow: 0 10px 20px rgba(13, 148, 136, 0.15);
    }

    .form-title {
        font-weight: 800;
        font-size: 1.8rem;
        color: #0f172a;
        letter-spacing: -0.5px;
    }

    /* Modern Inputs */
    .form-label {
        font-weight: 600;
        color: #475569;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .form-control {
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.8rem 1.2rem;
        font-size: 1rem;
        color: #1e293b;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        background: white;
        border-color: #0d9488;
        box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.1);
        outline: none;
    }

    .form-group-modern {
        margin-bottom: 1.8rem;
    }

    .grades-grid {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 1.8rem;
    }

    /* Buttons */
    .btn-submit {
        background: linear-gradient(135deg, #0d9488, #0f766e);
        color: white;
        font-weight: 700;
        border: none;
        padding: 0.8rem 2rem;
        border-radius: 12px;
        width: 100%;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(13, 148, 136, 0.2);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(13, 148, 136, 0.3);
    }

    .btn-cancel {
        color: #64748b;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        margin-top: 1rem;
        transition: color 0.2s;
    }
    
    .btn-cancel:hover {
        color: #0f172a;
    }
</style>

<div class="form-container">
    <div class="glass-form-card">
        <div class="form-header">
            <div class="form-icon">
                <i class="fa-solid fa-pen-to-square"></i>
            </div>
            <h2 class="form-title">Sınav Sonucunu Düzenle</h2>
            <p class="text-secondary">Öğrenciye ait mevcut sınav notlarını güncelleyin.</p>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3 fw-bold" })
            @Html.HiddenFor(m => m.SinavSonucID)

            <div class="row">
                <div class="col-md-6 form-group-modern">
                    @Html.Label("OgrenciID", "Öğrenci", new { @class = "form-label" })
                    @Html.DropDownList("OgrenciID", null, "-- Öğrenci Seçin --", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.OgrenciID, "", new { @class = "text-danger small fw-semibold mt-1 d-block" })
                </div>
                <div class="col-md-6 form-group-modern">
                    @Html.Label("DersID", "Ders", new { @class = "form-label" })
                    @Html.DropDownList("DersID", null, "-- Ders Seçin --", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.DersID, "", new { @class = "text-danger small fw-semibold mt-1 d-block" })
                </div>
            </div>

            <div class="grades-grid">
                <p class="text-uppercase fw-bold text-muted small mb-3"><i class="fa-solid fa-chart-pie me-1"></i> Notlandırma Detayları</p>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        @Html.LabelFor(m => m.VizePuani, "Vize Puanı", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.VizePuani, new { @class = "form-control fw-bold", type = "number", step = "0.01", placeholder = "Örn: 70" })
                        @Html.ValidationMessageFor(m => m.VizePuani, "", new { @class = "text-danger small fw-semibold mt-1 d-block" })
                    </div>
                    <div class="col-md-4 mb-3">
                        @Html.LabelFor(m => m.FinalPuani, "Final Puanı", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.FinalPuani, new { @class = "form-control fw-bold", type = "number", step = "0.01", placeholder = "Örn: 85" })
                        @Html.ValidationMessageFor(m => m.FinalPuani, "", new { @class = "text-danger small fw-semibold mt-1 d-block" })
                    </div>
                    <div class="col-md-4 mb-3">
                        @Html.LabelFor(m => m.HarfNotu, "Harf Notu", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.HarfNotu, new { @class = "form-control fw-bold text-primary text-uppercase", placeholder = "AA, BA..." })
                        @Html.ValidationMessageFor(m => m.HarfNotu, "", new { @class = "text-danger small fw-semibold mt-1 d-block" })
                    </div>
                </div>
                
                @* Ortalama can be calculated on backend or user input, if it is in model and needs editing, we add it here, but mostly we rely on what's there. 
                   The original form didn't have Ortalama input but the DB has it. Let's add it for completeness. *@
                <div class="row">
                    <div class="col-md-4 mb-3">
                        @Html.LabelFor(m => m.Ortalama, "Hesaplanmış Ortalama", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Ortalama, new { @class = "form-control fw-bold text-success", type = "number", step = "0.01", placeholder = "Örn: 77.5" })
                        @Html.ValidationMessageFor(m => m.Ortalama, "", new { @class = "text-danger small fw-semibold mt-1 d-block" })
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 form-group-modern">
                    @Html.LabelFor(m => m.Durum, "Durum", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Durum, new { @class = "form-control", placeholder = "Geçti / Kaldı" })
                    @Html.ValidationMessageFor(m => m.Durum, "", new { @class = "text-danger small fw-semibold mt-1 d-block" })
                </div>
                <div class="col-md-6 form-group-modern">
                    @Html.LabelFor(m => m.SinavTarihi, "Sınav Tarihi", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.SinavTarihi, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
                    @Html.ValidationMessageFor(m => m.SinavTarihi, "", new { @class = "text-danger small fw-semibold mt-1 d-block" })
                </div>
            </div>

            <div class="text-center mt-2">
                <button type="submit" class="btn btn-submit">
                    <i class="fa-solid fa-floppy-disk me-2"></i> Değişiklikleri Kaydet
                </button>
                <br />
                <a href="@Url.Action("Index")" class="btn-cancel">
                    <i class="fa-solid fa-arrow-left me-1"></i> İptal Et ve Geri Dön
                </a>
            </div>
        }
    </div>
</div>
